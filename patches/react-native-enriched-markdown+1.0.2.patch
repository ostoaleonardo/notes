@@ -0,0 +1,55 @@
+package com.swmansion.enriched.markdown.utils.text.interaction
+
+import android.view.MotionEvent
+import android.view.ViewConfiguration
+import android.widget.TextView
+import kotlin.math.abs
+
+class ImageTouchHelper(
+  private val textView: TextView,
+) {
+  var onImageTap: ((url: String) -> Unit)? = null
+
+  var isEnabled: Boolean = true
+
+  private var touchDownX = 0f
+  private var touchDownY = 0f
+  private var pendingUrl: String? = null
+  private val touchSlop: Int by lazy { ViewConfiguration.get(textView.context).scaledTouchSlop }
+
+  /** Returns `true` if the event was consumed by an image tap gesture. */
+  fun onTouchEvent(event: MotionEvent): Boolean {
+    if (!isEnabled) return false
+    when (event.actionMasked) {
+      MotionEvent.ACTION_DOWN -> {
+        val url = ImageTapUtils.hitTest(textView, event.x, event.y) ?: return false
+        touchDownX = event.x
+        touchDownY = event.y
+        pendingUrl = url
+        return true
+      }
+
+      MotionEvent.ACTION_MOVE -> {
+        if (pendingUrl != null && isExceedingSlop(event)) {
+          pendingUrl = null
+        }
+      }
+
+      MotionEvent.ACTION_UP -> {
+        val url = pendingUrl ?: return false
+        pendingUrl = null
+        if (!isExceedingSlop(event)) {
+          onImageTap?.invoke(url)
+        }
+        return true
+      }
+
+      MotionEvent.ACTION_CANCEL -> {
+        pendingUrl = null
+      }
+    }
+    return pendingUrl != null
+  }
+
+  private fun isExceedingSlop(event: MotionEvent): Boolean = abs(event.x - touchDownX) > touchSlop || abs(event.y - touchDownY) > touchSlop
+}
