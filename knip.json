{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "app/**/*.js",
        "plugins/*.js",
        "scripts/*.js",
        "src/shared/hooks/use-dev-menu.js",
        "src/**/__perf__/*.perf.js"
      ],
      "project": [
        "src/**/*.js",
        "app/**/*.js",
        "plugins/*.js",
        "scripts/*.js"
      ],
      "paths": {
        "@/*": [
          "src/*"
        ]
      },
      "ignoreDependencies": [
        "expo-updates"
      ]
    },
    "packages/*": {}
  }
}
