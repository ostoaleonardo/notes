{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.js",
    "plugins/*.js",
    "scripts/*.js",
    "src/hooks/use-dev-menu.js"
  ],
  "project": [
    "src/**/*.js",
    "app/**/*.js",
    "plugins/*.js",
    "scripts/*.js"
  ],
  "paths": {
    "@/*": [
      "src/*"
    ]
  },
  "ignoreDependencies": [
    "expo-updates"
  ]
}
