{
  "name": "notes",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-ui"]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src app",
    "postinstall": "patch-package",
    "test:maestro": "bash scripts/test-maestro.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@expo/metro-runtime": "~58.0.16",
    "@expo/ui": "~58.0.26",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@lezer/markdown": "^1.7.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.17",
    "expo": "^58.0.0",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-iap": "^3.4.1-rc.1",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.29",
    "expo-screen-orientation": "~58.0.3",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "i18next": "^23.15.1",
    "intl-pluralrules": "^2.0.1",
    "js-yaml": "^5.4.2",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "pdfjs-dist": "3.11.174",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^15.0.2",
    "react-native": "0.88.1",
    "react-native-drawer-layout": "^4.2.10",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-zoom-toolkit": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.5",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "babel-preset-expo": "~58.0.23",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-expo": "~58.0.13",
    "patch-package": "^8.0.1",
    "test-renderer": "^1.2.0"
  },
  "private": true,
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "app/**/*.js",
      "!**/__tests__/**",
      "!**/__fixtures__/**"
    ],
    "projects": [
      {
        "displayName": "native",
        "preset": "jest-expo",
        "setupFiles": [
          "<rootDir>/jest/setup-idle-callback.js"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/dom-tests/"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        }
      },
      {
        "displayName": "dom",
        "testEnvironment": "jsdom",
        "testMatch": [
          "**/dom-tests/**/*.test.js"
        ],
        "transform": {
          "^.+\\.[jt]sx?$": "babel-jest"
        },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        }
      }
    ]
  }
}
